# cp .env.example .env 후 값 입력 (.env는 커밋 금지)

# 공통
# Linux는 id -u 값
AIRFLOW_UID=50000
# 외부 접속 필요 시 0.0.0.0 (방화벽 필수)
BIND_IP=127.0.0.1

# 서울 열린데이터광장 API 키
# 실시간 도로소통정보 (OA-13291)
SEOUL_TRAFFIC_API_KEY=
# 행정동별 연료별 자동차 등록현황 (OA-21236)
SEOUL_REGISTRATION_API_KEY=
# api | csv
EV_REG_SOURCE_MODE=api

# Airflow 보안
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# 임의의 긴 문자열
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=

# Airflow 메타데이터 DB (DBeaver 5431)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# 분석 DB, PostGIS (DBeaver 5432)
# 비밀번호에 @ : / 사용 금지 (Connection URI 깨짐)
EV_DB_USER=ev_admin
EV_DB_PASSWORD=
EV_DB_NAME=ev_platform
# Rshiny 읽기 전용 계정
RSHINY_DB_PASSWORD=

# 워커·Pool
WORKER_CONCURRENCY=4
TRAFFIC_POOL_SLOTS=4
REGISTRATION_POOL_SLOTS=2

# 호스트 포트
AIRFLOW_PORT=8080
FLOWER_PORT=5555
RSHINY_PORT=3838
META_DB_PORT=5431
EV_DB_PORT=5432
